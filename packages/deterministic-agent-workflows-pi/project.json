{
  "name": "deterministic-agent-workflows-pi",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/deterministic-agent-workflows-pi/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/deterministic-agent-workflows-pi/tsconfig.build.json && node tools/rewrite-relative-import-extensions.mjs packages/deterministic-agent-workflows-pi/dist"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/deterministic-agent-workflows-pi/tsconfig.json --noEmit"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint packages/deterministic-agent-workflows-pi/src --ext .ts"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["build", "^build"],
      "options": {
        "command": "pnpm --dir packages/deterministic-agent-workflows-pi exec vitest run src && pnpm --dir packages/deterministic-agent-workflows-pi exec node smoke-test.mjs"
      }
    }
  }
}
